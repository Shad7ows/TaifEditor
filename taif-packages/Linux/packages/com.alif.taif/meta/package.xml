<?xml version="1.0" encoding="UTF-8"?>
<Package>
    <DisplayName>Taif</DisplayName>
    <Description>Taif Editor for Alif language.</Description>
    <Version>3.3.0</Version>
    <ReleaseDate>2026-05-18</ReleaseDate>
    <Licenses>
        <License name="Public License Agreement" file="license.txt" />
    </Licenses>
    <Default>true</Default>
    <RequiresAdminRights>true</RequiresAdminRights>
    <Operations>
        <!-- Add Taif to PATH in the user's bash config.
             The grep guard prevents duplicate entries on reinstall. -->
        <Operation name="Execute">
            <Argument>bash</Argument>
            <Argument>-c</Argument>
            <Argument>if ! grep -qF "@TargetDir@/alif" ~/.bashrc 2>/dev/null; then echo 'export PATH=@TargetDir@/alif:$PATH' >> ~/.bashrc; fi</Argument>
        </Operation>
        <Operation name="CreateDesktopEntry">
            <Argument>@HomeDir@/.local/share/applications/Taif.desktop</Argument> 
            <Argument>
                Type=Application
                Name=Taif
                Version=3.3.0
                Exec=@TargetDir@/Taif
                Icon=@TargetDir@/resources/TaifLogo.png
                Terminal=false
            </Argument> 
        </Operation>
    </Operations>
</Package>
